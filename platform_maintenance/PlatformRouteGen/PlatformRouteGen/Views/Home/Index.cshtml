@{
    ViewBag.Title = "Home Page";
    Layout = null;
}

<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Webslesson Tutorial</title>
    <script src="https://example.invalid/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
   @* <script src="https://example.invalid/bootstrap/3.3.6/js/bootstrap.min.js"></script>
    <link href="https://example.invalid/bootstrap/3.3.6/css/bootstrap.min.css" rel="stylesheet" />*@
   @* <script src="https://example.invalid/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>*@
    <link rel="stylesheet" href="https://example.invalid/bootstrap/4.1.3/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
     <script src="https://example.invalid/ajax/libs/popper.js/1.14.3/umd/popper.min.js" integrity="sha384-ZMP7rVo3mIykV+2+9J3UJ46jBk0WLaUAdn689aCwoqbBJiSnjAK/l8WvCWPIPm49" crossorigin="anonymous"></script>
    <script src="https://example.invalid/bootstrap/4.1.3/js/bootstrap.min.js" integrity="sha384-ChfqqxuZUCnJSK3+MXmPNIyE6ZbWh2IMqE241rYiqJxyMiZ6OW/JmZQ5stwEULTy" crossorigin="anonymous"></script>
    
    <script>
        var q = {};
    </script>
    <script>

        function assignKV(f) {
            f();
            load_data();
        }

        function load_data(query)
        {
            
            q['so'] = (q['so'] === 0 || q['so'] > 0) ? q['so'] : 99;         
            q['br'] = (q['br'] === 0 || q['br'] > 0) ? q['br'] : 99;         
            q['fs'] = (q['fs'] === 0 || q['fs'] > 0) ? q['fs'] : 99;
            q['ver'] = (q['ver'] === 0 || q['ver'] > 0) ? q['ver'] : 99;
            q['ag'] = (q['ag'] === 0 || q['ag'] > 0) ? q['ag'] : 99;
            q['pf'] = (q['pf'] === 0 || q['pf'] > 0) ? q['pf'] : 99;
           

            $.ajax({
                url:"@Url.Action("all","api/pr")",
            method:"POST",
            data: {
                appname: q['appname'],
                so: q['so'],
                br: q['br'],
                fs: q['fs'],
                ver: q['ver'],
                ag: q['ag'],
                pf: q['pf']

            },
            success:function(data)
            {
                $('#result').html(data);
            }
        });
        }
    </script>
    <script>
$(document).ready(function(){
  
 load_data(); 
 
 $('#search_text').keyup(function(){
  var search = $(this).val();
  if(search != '')
  {
      q['appname'] = search;
   load_data();
  }
  else
  {
   load_data();
  }
 });
});
    </script>

  <style>
      .site-header {
  background-color: rgba(0, 0, 0, .85);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  backdrop-filter: saturate(180%) blur(20px);
}
      .site-header a {
  color: #999;
  transition: ease-in-out color .15s;
}
.site-header a:hover {
  color: #fff;
  text-decoration: none;
}


  </style> 
</head>
<body>
    <nav class="site-header sticky-top py-1">
        <div class="container d-flex flex-column flex-md-row justify-content-between">
            <a class="py-2" href="#">
                <svg xmlns="http://example.invalid/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="d-block mx-auto" role="img" viewBox="0 0 24 24" focusable="false"><title>Product</title><circle cx="12" cy="12" r="10"></circle><path d="M14.31 8l5.74 9.94M9.69 8h11.48M7.38 12l5.74-9.94M9.69 16L3.95 6.06M14.31 16H2.83m13.79-4l-5.74 9.94"></path></svg>
            </a>
            @Html.ActionLink("路由表管理", "Index","Home", null, new { @class = "py-2 d-none d-md-inline-block" })
            @Html.ActionLink("打包清單", "BuildList", "GameVer",null, new { @class = "py-2 d-none d-md-inline-block" })
            @Html.ActionLink("遊戲版本管理", "Index", "GameVer", null, new { @class = "py-2 d-none d-md-inline-block" })
        </div>
    </nav>
    <div class="container" style="width:1400px; max-width:1600px;">
        <br />
        <h2 align="center">Platform Route </h2><br />
        <div class="form-group">
            <div class="btn-group">
                <button type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Server Option
                </button>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['so'] = 99; })">ALL</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['so'] = -1; })">-1 哪兒都不去</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['so'] = 0; })">0 開發(100)</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['so'] = 1; })">1 QA(101)</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['so'] = 2; })">2</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['so'] = 3; })">3 美服</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['so'] = 4; })">4 國服</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['so'] = 5; })">5 Stage</a>
                </div>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Branch
                </button>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['br'] = 0; })">方舟</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['br'] = 1; })">986</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['br'] = 2; })">藍鑽</a>
                </div>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Flag Share
                </button>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['fs'] = 99; })">ALL</a>                   
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['fs'] = 0; })">關閉</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['fs'] = 1; })">開啟</a>
                </div>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                   Version
                </button>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['ver'] = 99; })">ALL</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['ver'] = 0; })">關閉</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['ver'] = 1; })">開啟</a>
                </div>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Agent
                </button>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['ag'] = 99; })">ALL</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['ag'] = 0; })">關閉</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['ag'] = 1; })">開啟</a>
                </div>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Platform
                </button>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['pf'] = 99; })">ALL</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['pf'] = 1; })">IOS</a>
                    <a class="dropdown-item" href="#" onclick="assignKV(function () { q['pf'] = 2; })">ANDROID</a>
                </div>
            </div>
            <div class="btn-group float-right">
                <a class="btn btn-primary " href="@Url.Action("Create")" role="button">Create</a>
            </div>
            <div class="btn-group float-right">
                <a class="btn btn-primary " href="@Url.Action("GetFile")/?platform=2" role="button">GEN_ANDROID </a>
            </div>
            <div class="btn-group float-right">
                <a class="btn btn-primary " href="@Url.Action("GetFile")/?platform=1" role="button">GEN_IOS </a>
            </div>
            

                <div><hr /></div>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="basic-addon1">@@</span>
                    </div>
                    @*<span class="input-group-addon">Search</span>*@
                    <input type="text" name="search_text" id="search_text" placeholder="Search by App Name" class="form-control" />
                </div>
            </div>
        <br />
        <div id="result"></div>
    </div>
</body>
</html>


