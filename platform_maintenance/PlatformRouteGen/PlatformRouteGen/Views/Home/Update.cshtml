@model  PlatformRoute
@{
    ViewBag.Title = "Update";
    Layout = null;
}


<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Webslesson Tutorial</title>
    <script src="https://example.invalid/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
    @* <script src="https://example.invalid/bootstrap/3.3.6/js/bootstrap.min.js"></script>
        <link href="https://example.invalid/bootstrap/3.3.6/css/bootstrap.min.css" rel="stylesheet" />*@
    @* <script src="https://example.invalid/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>*@
    <link rel="stylesheet" href="https://example.invalid/bootstrap/4.1.3/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <script src="https://example.invalid/ajax/libs/popper.js/1.14.3/umd/popper.min.js" integrity="sha384-ZMP7rVo3mIykV+2+9J3UJ46jBk0WLaUAdn689aCwoqbBJiSnjAK/l8WvCWPIPm49" crossorigin="anonymous"></script>
    <script src="https://example.invalid/bootstrap/4.1.3/js/bootstrap.min.js" integrity="sha384-ChfqqxuZUCnJSK3+MXmPNIyE6ZbWh2IMqE241rYiqJxyMiZ6OW/JmZQ5stwEULTy" crossorigin="anonymous"></script>

 


</head>
<body>
    <div class="container" style="width:1400px; max-width:1600px;">
        <br />
        <form class="needs-validation" action="@Url.Action("Update")" method="post" novalidate>
            <input type="hidden" name="Appkey" value="@Model.AppKey" >
            <div class="form-row">
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip01">Index</label>
                    <input type="text" class="form-control" id="validationIndex" name="Index" placeholder="Index" value="@Model.Index" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip02">CompanyName</label>
                    <input type="text" class="form-control" id="validationCompanyName" placeholder="CompanyName" name="CompanyName" value="@Model.CompanyName" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
                
            </div>
            <div class="form-row">
                <div class="col-md-4 mb-3">
                    <label for="validationTooltipUsername">BundleID</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text" id="validationBundleID">@@</span>
                        </div>
                        <input type="text" class="form-control" id="validationBundleID" name="BundleID" placeholder="BundleID" aria-describedby="validationTooltipUsernamePrepend" value="@Model.BundleID" required>
                        <div class="invalid-tooltip">
                            Please choose a unique and valid username.
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip02">AppName</label>
                    <input type="text" class="form-control" id="validationAppName" placeholder="AppName" name="AppName" value="@Model.AppName" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
               
            </div>
            <div class="form-row">
                <div class="col-md-4 mb-0">
					<div class="col-md-0 mb-2">
						ServerOption
					</div>
				
                    <div class="form-group">
                        <select class="custom-select" name="ServerOption" required>
                            <option value="">Server Option</option>
                            <option value="-1" @if(Model.ServerOption==-1) {
                                @:selected
                                     } >-1</option>
                            <option value="0" @if(Model.ServerOption==0) {
                                @:selected
                                     }>0</option>
                            <option value="1" @if(Model.ServerOption==1) {
                                @:selected
                                     }>1</option>
                            <option value="2" @if(Model.ServerOption==2) {
                                @:selected
                                     }>2</option>
                            <option value="3" @if(Model.ServerOption==3) {
                                @:selected
                                     }>3</option>
                            <option value="4" @if(Model.ServerOption==4) {
                                @:selected
                                     }>國服</option>
                            <option value="5" @if(Model.ServerOption==5) {
                                @:selected
                                     }>5</option>
                          
                        </select>
                        <div class="invalid-feedback">Example invalid custom select feedback</div>
                    </div>
                </div>
				
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip02">ProductName</label>
                    <input type="text" class="form-control" id="validationProductName" placeholder="ProductName" name="ProductName" value="@Model.ProductName" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
            </div>
            <div class="form-row">
				<div class="col-md-4 mb-0">
					<div class="col-md-0 mb-2">
						Branch
					</div>				
                    <div class="form-group">
                        <select class="custom-select" name="Branch" required>
                            <option value="">Branch</option>
                            <option value="0" @if(Model.Branch==0) {
                                @:selected
                                     }>方舟</option>
                            <option value="1" @if(Model.Branch==1) {
                                @:selected
                                     }>986</option>
                            <option value="2" @if(Model.Branch==2) {
                                @:selected
                                     }>藍鑽</option>
                          
                        </select>
                        <div class="invalid-feedback">Example invalid custom select feedback</div>
                    </div>
                </div>				
            </div>			
            <div class="form-row">
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip02">PlatformID</label>
                    <input type="text" class="form-control" id="validationPlatformID" placeholder="PlatformID" name="PlatformID" value="@Model.PlatformID" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip02">AppleID</label>
                    <input type="text" class="form-control" id="validationAppleID" placeholder="AppleID" name="AppleID" value="@Model.AppleID" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
            </div>
            <div class="form-row">
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip02">SiteID</label>
                    <input type="text" class="form-control" id="validationSiteID" placeholder="SiteID" name="SiteID" value="@Model.SiteID" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip02">StaticSiteID</label>
                    <input type="text" class="form-control" id="validationStaticSiteID" placeholder="StaticSiteID" name="StaticSiteID" value="@Model.StaticSiteID" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
            </div>
            <div class="form-row">
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip02">Template</label>
                    <input type="text" class="form-control" id="validationTemplate" placeholder="Template" name="Template" value="@Model.Template" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="validationTooltip02">IconName</label>
                    <input type="text" class="form-control" id="validationIconName" placeholder="IconName" name="IconName" value="@Model.IconName" required>
                    <div class="valid-tooltip">
                        Looks good!
                    </div>
                </div>
            </div>
            <div class="form-row">
                <div class="custom-control custom-checkbox mb-3">
                    <input type="checkbox" class="custom-control-input" id="FlagShareValidation1" name="FlagShare" @if(Model.FlagShare==1) {
                                @:checked
                                     } required>
                    <label class="custom-control-label" for="FlagShareValidation1">FlagShare</label>
                    <div class="invalid-feedback">Example invalid feedback text</div>
                </div>
                <div class="custom-control custom-checkbox mb-3">
                    <input type="checkbox" class="custom-control-input" id="VersionValidation1" name="Version" @if(Model.Version==1) {
                                @:checked
                                     } required>
                    <label class="custom-control-label" for="VersionValidation1">Version</label>
                    <div class="invalid-feedback">Example invalid feedback text</div>
                </div>
                <div class="custom-control custom-checkbox mb-3">
                    <input type="checkbox" class="custom-control-input" id="AgentValidation1" name="Agent" @if(Model.Agent==1) {
                                @:checked
                                     } required>
                    <label class="custom-control-label" for="AgentValidation1">Agent</label>
                    <div class="invalid-feedback">Example invalid feedback text</div>
                </div>
                <div class="custom-control custom-checkbox mb-3">
                    <input type="checkbox" class="custom-control-input" id="NotExportValidation1" name="NotExport" @if (Model.NotExport == "1") { @: checked
                                                                } required>
                    <label class="custom-control-label" for="NotExportValidation1">NotExport</label>
                    <div class="invalid-feedback">Example invalid feedback text</div>
                </div>

            </div>
         
               
           <button class="btn btn-primary" type="submit">修改</button>
</form>
    </div>
</body>
</html>

